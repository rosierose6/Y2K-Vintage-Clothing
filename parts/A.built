<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light only" />
<meta name="theme-color" content="#0e0e0e" />
<meta name="google-site-verification" content="HPBxC9Fs_5nMhaDtrxnxJggaZpxIydLMu5C33OSO2TQ" />

<!-- Primary SEO -->
<title>Y2K Vintage Clothing — Curated Y2K, Vintage &amp; Fairycore Thrift Shop</title>
<meta name="description" content="Y2K Vintage Clothing — a curated shop of one-of-a-kind Y2K, vintage & fairycore pieces. Hand-picked, honestly described, and shipped through Depop. Shop the collection.">
<link rel="canonical" href="https://www.y2kvintageclothing.com/">

<!-- Open Graph (Facebook, Pinterest, iMessage previews) -->
<meta property="og:type" content="website">
<meta property="og:title" content="Y2K Vintage Clothing — Curated Y2K &amp; Vintage">
<meta property="og:description" content="One-of-a-kind Y2K, vintage & fairycore finds. Hand-picked thrift, shipped through Depop.">
<meta property="og:url" content="https://www.y2kvintageclothing.com/">
<meta property="og:image" content="https://www.y2kvintageclothing.com/preview.jpg">
<meta property="og:site_name" content="Y2K Vintage Clothing">

<!-- Twitter/X card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Y2K Vintage Clothing — Curated Y2K &amp; Vintage">
<meta name="twitter:description" content="One-of-a-kind Y2K, vintage & fairycore finds. Hand-picked thrift, shipped through Depop.">
<meta name="twitter:image" content="https://www.y2kvintageclothing.com/preview.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Jost:wght@300;400;500&family=Nunito+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root{
    color-scheme:light only;
    --bg:#fdf1f5;
    --ink:#141414;
    --muted:#8d7480;
    --rose:#c9799a;
    --rose-soft:#f4c3d6;
    --line:#f0d5e0;
    --black:#0e0e0e;
    --serif:'Playfair Display', Georgia, serif;
    --sans:'Jost', sans-serif;
    --body:'Nunito Sans', sans-serif;
    /* small round gold dust, three parallax layers */
    --dust:radial-gradient(circle, #ffd35f 0 .7px, rgba(240,190,70,1) .7px 1.1px, transparent 1.9px),radial-gradient(circle, #ffca47 0 .58px, rgba(226,170,55,1) .58px .9px, transparent 1.6px),radial-gradient(circle, #ffdf85 0 .64px, rgba(245,200,90,1) .64px 1px, transparent 1.7px);
    --dust-size:152px 152px,116px 116px,196px 196px;
    --dust-pos:0 0,40px 50px,80px 24px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;background:#fdf1f5}

  /* Site is intentionally light-only. `color-scheme: light only` above tells the
     browser (incl. Android/Chrome "force dark") not to auto-darken the page. */
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:var(--body);
    font-weight:300;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}

  /* decorative sparkle layer */
  .sparkle{
    position:fixed;inset:0;z-index:0;pointer-events:none;
    background-image:var(--dust);
    background-size:var(--dust-size);
    background-position:var(--dust-pos);
    filter:drop-shadow(0 0 2.6px rgba(255,190,70,.85)) drop-shadow(0 0 1.2px rgba(255,208,105,.9));
    animation:twinkle 5s ease-in-out infinite;
  }
  @keyframes twinkle{0%,100%{opacity:.38}50%{opacity:.55}}
  @media (prefers-reduced-motion: reduce){.sparkle{animation:none;opacity:.5}}

  .wrap{max-width:1240px;margin:0 auto;padding:0 40px;position:relative;z-index:1}

  /* eyebrow / labels */
  .eyebrow{
    font-family:var(--sans);
    text-transform:uppercase;
    letter-spacing:.42em;
    font-size:.72rem;
    color:var(--muted);
    font-weight:400;
  }

  /* headings */
  h1,h2,h3{font-family:var(--serif);font-weight:500;letter-spacing:.01em}
  .section-head{text-align:center;margin-bottom:70px}
  .section-head h2{font-size:2.9rem;line-height:1.12;margin-top:14px}
  .section-head h2 em{font-style:italic;color:var(--rose)}
  .rule{width:64px;height:2px;background:var(--rose);margin:26px auto 0}

  /* ---------- HEADER ---------- */
  header.site{
    position:fixed;top:0;left:0;right:0;z-index:50;
    display:flex;align-items:center;justify-content:space-between;
    padding:9px 48px;
    background:#0e0e0e;
    transition:box-shadow .3s ease;
  }
  header.site.scrolled{box-shadow:0 1px 0 rgba(255,255,255,.08)}
  .logo{font-family:var(--sans);font-weight:500;letter-spacing:.32em;font-size:.92rem;color:#fff}
  nav.primary{display:flex;align-items:center;gap:42px}
  nav.primary a{
    font-family:var(--sans);text-transform:uppercase;
    letter-spacing:.22em;font-size:.74rem;color:#fff;
    transition:color .2s ease;
  }
  nav.primary a:hover{color:var(--rose-soft)}
  .menu-btn{display:none;background:none;border:none;cursor:pointer}

  /* ---------- MOBILE SLIDE-IN MENU ---------- */
  .mobile-nav{position:fixed;inset:0;z-index:60;visibility:hidden;pointer-events:none}
  .mobile-nav .overlay{position:absolute;inset:0;background:rgba(0,0,0,.5);opacity:0;transition:opacity .3s ease}
  .mobile-nav .panel{position:absolute;top:0;right:0;height:100%;width:min(80vw,320px);background:#0e0e0e;
    transform:translateX(100%);transition:transform .32s ease;display:flex;flex-direction:column;
    padding:78px 32px 40px;gap:4px;box-shadow:-14px 0 40px rgba(0,0,0,.4)}
  .mobile-nav.open{visibility:visible;pointer-events:auto}
  .mobile-nav.open .overlay{opacity:1}
  .mobile-nav.open .panel{transform:translateX(0)}
  .mobile-nav a{font-family:var(--sans);text-transform:uppercase;letter-spacing:.2em;font-size:.82rem;
    color:#fff;padding:18px 2px;border-bottom:1px solid rgba(255,255,255,.08);transition:color .2s ease}
  .mobile-nav a:hover{color:var(--rose-soft)}
  .mobile-nav .close{position:absolute;top:20px;right:22px;background:none;border:none;color:#fff;cursor:pointer;padding:6px;line-height:0}

  /* ---------- BUTTONS ---------- */
  .btn{
    display:inline-block;
    background:var(--ink);color:#fff;border:1px solid var(--ink);
    font-family:var(--sans);text-transform:uppercase;letter-spacing:.22em;font-size:.72rem;
    padding:17px 34px;cursor:pointer;transition:opacity .2s ease;
  }
  .btn:hover{opacity:.82}
  .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--ink)}
  .btn.ghost:hover{background:var(--ink);color:#fff;opacity:1}

  /* ---------- HERO ---------- */
  .hero{min-height:92vh;display:flex;flex-direction:column;justify-content:center;padding:150px 0 90px;position:relative}
  .hero .wrap{width:100%;text-align:left;position:relative;z-index:2}
  .hero .eyebrow{margin-bottom:28px}
  .hero h1{font-size:3.6rem;line-height:1.05;font-weight:500}
  .hero h1 .it{display:block;font-style:italic;font-weight:500}
  .hero .lede{max-width:430px;margin-top:40px;font-size:1.12rem;color:#33262b;line-height:1.7}
  .hero .cta{margin-top:42px}
  .hero-dust{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.46;background-image:var(--dust);background-size:var(--dust-size);background-position:var(--dust-pos);filter:drop-shadow(0 0 2.6px rgba(255,190,70,.85)) drop-shadow(0 0 1.2px rgba(255,208,105,.9))}
  .float{position:absolute;font-size:26px;opacity:.8;animation:drift 5s ease-in-out infinite;user-select:none;z-index:2}
  .f1{top:26%;right:24%;animation-delay:0s}
  .f2{top:38%;right:11%;animation-delay:1.2s}
  .f3{bottom:28%;right:32%;animation-delay:2.4s;font-size:20px}
  .f4{bottom:20%;right:16%;animation-delay:3.4s;font-size:20px}
  @keyframes drift{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-16px) rotate(5deg)}}
  @media (prefers-reduced-motion: reduce){.float{animation:none}}

  /* ---------- SECTIONS ---------- */
  section{padding:110px 0;position:relative}
  .divider{text-align:center;color:var(--rose);font-size:15px;letter-spacing:1.2em;padding-left:1.2em;opacity:.6;position:relative;z-index:1}

  /* ---------- COLLECTION ---------- */
  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:54px 44px}
  .item{
    display:block;background:none;padding:0;box-shadow:none;
    transition:transform .35s ease;cursor:pointer;
  }
  .item:hover{transform:translateY(-8px)}
  .item .ph{
    aspect-ratio:3/4;position:relative;overflow:hidden;
    display:flex;align-items:center;justify-content:center;
    /* set via gradient (background-image) so Chrome/Android "force dark" leaves it alone */
    background-color:#ffffff;
    background-image:linear-gradient(0deg,#ffffff,#ffffff);
  }
  .item .ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
  .item:hover .ph img{transform:scale(1.04)}
  .ph .phlabel{font-family:var(--sans);letter-spacing:.34em;font-size:.6rem;color:#cb9cb1;text-transform:uppercase}
  .ph .tag{
    position:absolute;top:16px;left:50%;transform:translateX(-50%);
    background:#0e0e0e;color:#fff;
    font-family:var(--sans);font-size:.58rem;font-weight:400;
    letter-spacing:.26em;text-transform:uppercase;
    padding:6px 14px;z-index:2;white-space:nowrap;
  }
  .item .meta{padding:20px 4px 0;text-align:center}
  .item .name{font-family:var(--serif);font-size:1.18rem;font-weight:500;line-height:1.3}
  .item .details{
    display:flex;justify-content:center;gap:14px;margin-top:8px;
    font-family:var(--sans);text-transform:uppercase;letter-spacing:.16em;font-size:.62rem;color:var(--muted);
  }
  .item .details .price{color:var(--rose);font-weight:500}
  .item .view{
    display:inline-block;margin-top:14px;font-family:var(--sans);
    text-transform:uppercase;letter-spacing:.2em;font-size:.62rem;color:var(--ink);
    border-bottom:1px solid var(--rose);padding-bottom:3px;
  }
  .collection-more{text-align:center;margin-top:70px}

  /* ---------- ABOUT ---------- */
  .about-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:90px;align-items:start;max-width:1040px;margin:0 auto}
  .about-grid h3{font-size:2.3rem;line-height:1.16;font-weight:500}
  .about-grid h3 em{font-style:italic;color:var(--rose)}
  .about-grid p{font-size:1rem;color:#55434a;line-height:1.75;margin-bottom:18px}
  .about-grid p:last-of-type{margin-bottom:0}

  /* ---------- VALUES ---------- */
  .values{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;text-align:center}
  .vcard .icon{
    width:74px;height:74px;border:1px solid var(--line);border-radius:50%;
    display:flex;align-items:center;justify-content:center;margin:0 auto 26px;
    font-size:26px;line-height:1;
  }
  .vcard h4{font-family:var(--serif);font-size:1.25rem;font-weight:500;font-style:italic;margin-bottom:16px;line-height:1.25}
  .vcard p{font-size:.92rem;color:#6b5560;line-height:1.65}

  /* ---------- CLOSING ---------- */
  .closing{text-align:center}
  .closing h2{font-size:2.9rem;margin-top:14px;line-height:1.12}
  .closing h2 em{font-style:italic;color:var(--rose)}
  .closing .lede{max-width:480px;margin:36px auto 40px;color:#55434a;font-size:1.05rem}

  /* ---------- FOOTER ---------- */
  footer{
    background:var(--black);
    color:#fceaf1;text-align:center;
    padding:26px 20px 30px;position:relative;z-index:2;overflow:hidden;
  }
  footer .fine{
    display:flex;justify-content:center;align-items:center;gap:26px;flex-wrap:wrap;
    font-family:var(--sans);text-transform:uppercase;letter-spacing:.28em;font-size:.7rem;color:#eec4d5;
  }
  footer .fine a{border-bottom:1px solid var(--rose);padding-bottom:2px;transition:color .2s ease}
  footer .fine a:hover{color:#fff}
  footer .mark{
    position:absolute;right:34px;bottom:8px;font-size:1.7rem;color:rgba(255,255,255,.16);
    font-family:var(--serif);letter-spacing:.1em;
  }

  /* ---------- RESPONSIVE ---------- */
  @media(max-width:1024px){
    .grid{grid-template-columns:repeat(3,1fr)}
    .about-grid{grid-template-columns:1fr;gap:40px}
  }
  @media(max-width:760px){
    .wrap{padding:0 24px}
    header.site{padding:20px 24px}
    nav.primary{display:none}
    .menu-btn{display:flex}
    .hero{min-height:auto;padding:120px 0 70px}
    .hero .wrap{text-align:center}
    .hero h1{font-size:2.6rem}
    .hero .lede{font-size:1rem;margin-left:auto;margin-right:auto}
    .float{display:none}
    .section-head h2,.closing h2{font-size:2.1rem}
    .grid{grid-template-columns:repeat(2,1fr);gap:34px 22px}
    .values{grid-template-columns:1fr;gap:46px}
    section{padding:80px 0}
    footer .fine{flex-direction:column;gap:12px}
  }
</style>
</head>
<body>
<div class="sparkle"></div>

<header class="site" id="header">
  <a href="#" class="logo">Y2K VINTAGE CLOTHING</a>
  <nav class="primary">
    <a href="#collection">Collection</a>
    <a href="#about">About</a>
    <a href="journal.html">Journal</a>
    <a href="https://www.depop.com/fairytqles" target="_blank" rel="noopener">Shop on Depop</a>
  </nav>
  <button class="menu-btn" aria-label="Open menu">
    <svg width="26" height="26" viewBox="0 0 24 24" stroke="#ffffff" stroke-width="1.4"><path d="M4 8h16M4 16h16"/></svg>
  </button>
</header>

<!-- Mobile slide-in menu -->
<div class="mobile-nav" id="mobileNav" aria-hidden="true">
  <div class="overlay" data-close></div>
  <nav class="panel" aria-label="Mobile navigation">
    <button class="close" aria-label="Close menu" data-close>
      <svg width="26" height="26" viewBox="0 0 24 24" stroke="#ffffff" stroke-width="1.4" fill="none"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <a href="#collection" data-close>Collection</a>
    <a href="#about" data-close>About</a>
    <a href="journal.html" data-close>Journal</a>
    <a href="https://www.depop.com/fairytqles" target="_blank" rel="noopener" data-close>Shop on Depop</a>
  </nav>
</div>

<!-- HERO -->
<div class="hero">
  <span class="float f1">🦋</span>
  <span class="float f2">🌷</span>
  <span class="float f3">✧</span>
  <span class="float f4">🍄</span>
  <div class="wrap">
    <p class="eyebrow">Curated Y2K &amp; Vintage · @fairytqles</p>
    <h1>Once Upon a Time,<span class="it">someone loved this</span></h1>
    <p class="lede">Curated Y2K, vintage &amp; fairycore pieces — one-of-a-kind and hand-picked with care. Every piece listed and shipped through Depop.</p>
    <a class="btn cta" href="https://www.depop.com/fairytqles" target="_blank" rel="noopener">Browse the Shop</a>
  </div>
  <div class="hero-dust" aria-hidden="true"></div>
</div>

<!-- COLLECTION -->
<section id="collection">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">The Collection</p>
      <h2>Latest <em>Finds</em></h2>
      <div class="rule"></div>
    </div>

    